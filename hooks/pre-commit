#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Source Rust toolchain (needed for NIF compilation)
# shellcheck disable=SC1091
[ -f "$HOME/.cargo/env" ] && source "$HOME/.cargo/env"

echo "==> cargo fmt --check (NIF)"
cargo fmt --check --manifest-path native/cashew/Cargo.toml

echo "==> cargo clippy (NIF)"
cargo clippy --manifest-path native/cashew/Cargo.toml -- -D warnings

echo "==> mix format"
mix format

echo "==> mix credo --strict"
mix credo --strict

echo "==> mix test"
mix test

echo "==> mix dialyzer"
mix dialyzer --format short

echo "All checks passed."
